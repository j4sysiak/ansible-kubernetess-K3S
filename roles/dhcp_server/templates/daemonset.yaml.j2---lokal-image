apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: dhcp-server
  namespace: {{ dhcp_namespace }}
spec:
  selector:
    matchLabels:
      app: dhcp-server
  template:
    metadata:
      labels:
        app: dhcp-server
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      containers:
        - name: dhcp
          image: {{ dhcp_image }}
          imagePullPolicy: Never
          securityContext:
            capabilities:
              add: ["NET_ADMIN","NET_RAW"]
          env:
            - name: INTERFACES
              value: "{{ dhcp_interface }}"
          ports:
            - containerPort: 67
              protocol: UDP
          volumeMounts:
            - name: leases
              mountPath: /var/lib/dhcp
      volumes:
        - name: leases
          emptyDir: {}